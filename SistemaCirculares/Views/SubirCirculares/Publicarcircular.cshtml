<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Publicar Circular</title>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/publicarcircular/circularjs.js"></script>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons (para el calendario / upload) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/gestioncircularescss/publicarcirculares.css" rel="stylesheet" />
    
</head>
<body>

    <div class="frame">
        <div class="frame-inner">
            <form id="formCircular" novalidate>
                <!-- Nombre + switch -->
                <div class="row g-3 align-items-start">
                    <div class="col-lg-8">
                        <div class="pill">
                            <input type="text" class="form-control" id="nombreCircular" placeholder="Nombre de la circular" required>
                        </div>
                    </div>
                    <div class="col-lg-4 d-flex justify-content-lg-end">
                        <div class="switch-card text-center w-100">
                            <small>Solo para<br>miembros del comité:</small>
                            <div class="form-check form-switch switch-lg d-inline-block">
                                <input class="form-check-input" type="checkbox" id="soloMiembros">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Subir archivo + (espaciado) -->
                <div class="row g-3 mt-2">
                    <div class="col-lg-6">
                        <label for="archivo" class="w-100 dropbox" id="dropArea">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <div class="label">Subir archivo</div>
                            <input type="file" id="archivo" class="d-none" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg">
                        </label>
                        <div id="fileInfo" class="text-muted mt-2"></div>
                    </div>
                </div>

                <!-- Agregar evento (opcional) -->
                <div class="mt-4">
                    <div class="mb-1 fw-bold">Agregar evento (opcional):</div>

                    <div class="pill input-group mb-3">
                        <input type="date" class="form-control" id="fechaEvento" placeholder="Seleccione una fecha">
                        <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                    </div>

                    <div class="pill mb-2">
                        <input type="text" class="form-control" id="nombreEvento" placeholder="Nombre del evento">
                    </div>
                </div>

                <!-- Publicar -->
                <div class="text-center mt-4">
                    <button id="btnPublicarCircular" type="submit" class="btn btn-grad">Publicar</button>
                </div>
            </form>
        </div>
    </div>

