@{
    var CantidadCirculares = ViewBag.CantidadCirculares ?? 0;
}

<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestión de Circulares</title>

    <link href="~/css/gestionusuarioscss/gestionusuarios.css" rel="stylesheet" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container py-5">

        <div class="page-card text-center">

            <h2 class="mb-4">Administración de Circulares</h2>

            <div class="alert alert-info fs-5">
                Cantidad de circulares en el sistema actualmente:
                <strong>@CantidadCirculares</strong>
            </div>

            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">

                <button id="btnEliminar50" class="btn btn-danger btn-lg">
                    Eliminar las primeras 50 circulares
                </button>

                <button id="btnEliminar100" class="btn btn-warning btn-lg">
                    Eliminar las primeras 100 circulares
                </button>

            </div>

        </div>

    </div>

    <script>

            document.getElementById("btnEliminar50").addEventListener("click", function(){
                let obj ={

                    IdComite: 1

                }
                if(confirm("¿Está seguro que desea eliminar las primeras 50 circulares?"))
                {
                               fetch('/Home/ObtenerCircularesPorCantidad', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(obj)
            })
            .then(response => response.blob())
            .then(blob => {

                const url = window.URL.createObjectURL(blob);

                const a = document.createElement("a");
                a.href = url;
                a.download = "Circulares.zip";

                document.body.appendChild(a);
                a.click();
                a.remove();

            });
                }

            });

            document.getElementById("btnEliminar100").addEventListener("click", function(){

                if(confirm("¿Está seguro que desea eliminar las primeras 100 circulares?"))
                {
                    fetch('/Circulares/EliminarPrimeras', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ cantidad: 100 })
                    })
                    .then(res => res.json())
                    .then(data => {
                        alert("Proceso realizado correctamente");
                        location.reload();
                    });
                }

            });

    </script>

</body>
</html>