@{

    var ListaComites = ViewBag.ListaComites;
}



<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestión de Comités</title>
    <link href="~/css/gestionusuarioscss/gestionusuarios.css" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons (flechas) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #f7f7f7;
        }

        /* Tarjeta envolvente */
        .page-card {
            background: #fff;
            border-radius: 18px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(0,0,0,.06);
        }

        /* Tabla estilo mockup */
        .table-committees {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
            border: 3px solid #7d3cff; /* borde morado exterior */
            border-radius: 10px;
            overflow: hidden;
            background: #fff;
        }

            .table-committees th {
                background: #bcbcbc;
                color: #fff;
                font-weight: 800;
                text-align: center;
                border-right: 3px solid #242424;
                border-bottom: 3px solid #242424;
                font-size: 1.05rem;
                padding: 1rem;
            }

                .table-committees th:last-child {
                    border-right: 0;
                }

            .table-committees td {
                border-top: 3px solid #242424;
                border-right: 3px solid #242424;
                font-size: 1.6rem;
                padding: 1.2rem 1rem;
                vertical-align: middle;
                background: #fff;
            }

            .table-committees tr:first-of-type td {
                border-top: 3px solid #242424;
            }

            .table-committees td:last-child {
                border-right: 0;
            }

        /* Cols proporciones */
        .col-comite {
            width: 50%;
        }

        .col-cant {
            width: 50%;
        }
/* 
        /* Contador + flechas alineadas a la derecha */
        .qty-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .75rem;
        }

        .qty-value {
            width: 3ch;
            text-align: center;
            font-weight: 700;
        } 
 */
        /* Fila seleccionada para eliminar */
        .row-selected {
            background: #f2f6ff !important;
        }

        /* Botones degradados */
        .btn-grad {
            color: #fff;
            border: 0;
            font-weight: 700;
            border-radius: 16px;
            padding: 16px 22px;
            box-shadow: 0 8px 18px rgba(0,0,0,.12);
        }

        .btn-bluegreen {
            background-image: linear-gradient(135deg,#7195ff,#8cdf9b);
        }

            .btn-bluegreen:hover {
                filter: brightness(.97);
            }

        /* Botones flecha verticales */
        .btn-arrow {
            border: 0;
            background: #d7d7d7;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .btn-arrow:active {
                transform: translateY(1px);
            }

            .btn-arrow i {
                font-size: 1.2rem;
                color: #6b6b6b;
            }

            .btn-arrow.up {
                margin-bottom: .25rem;
            }

            .btn-arrow.down {
            }

        /* Filas altas como el mockup */
        .table-committees td,
        .table-committees th {
            height: 84px;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <div class="page-card">
            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3 mb-4">
                <h1 class="m-0">Gestión de Comités</h1>
                <div class="d-flex gap-2">
                    <button data-bs-toggle="modal" data-bs-target="#modalCodigo" class="btn btn-grad btn-teal">Agregar comité</button>
                    <button id="btnEliminar" class="btn btn-grad btn-green">Eliminar comité</button>
                </div>
            </div>

            <div class="col-6 mx-auto">
                <table id="TbGestionUsuarios" class="table align-middle mb-0" >
                    <thead>
                        <tr>
                            <th class="col-comite">ID Comité</th>
                            <th class="col-comite">Comité</th>

                        </tr>
                    </thead>
                    <tbody>


                        @foreach (var item in ListaComites)
                        {

                            <tr>
                                <td>@item.IdComite</td>
                                <td>@item.NombreComite</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

        </div>
    </div>
    
    <!-- Modal Nuevo Comité -->
    <div class="modal fade" id="modalCodigo" tabindex="-1" aria-labelledby="modalNuevoComiteLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow">

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalNuevoComiteLabel">
                        Nuevo comité
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="txtNombreComite" class="form-label fw-semibold">
                            Nombre del comité
                        </label>
                        <input type="text"
                               class="form-control"
                               id="txtNombreComite"
                               placeholder="Ej: Comité de Deportes">
                    </div>

                    <div class="mb-3">
                        <label for="txtCantidadPersonas" class="form-label fw-semibold">
                            Cantidad de personas
                        </label>
                        <input type="number"
                               class="form-control"
                               id="txtCantidadPersonas"
                               min="1"
                               placeholder="Ej: 5">
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="button"
                            id="btnAceptarNuevoComite"
                            class="btn btn-teal">
                        Aceptar
                    </button>
                </div>

            </div>
        </div>
    </div>



    <div class="modal fade"  tabindex="-1" aria-labelledby="modalCodigoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-soft rounded-4 p-2">

                <!-- Borde degradado exterior -->
                <div class="gradient-frame rounded-4 p-3">
                    <div class="modal-body text-center px-3 px-md-4">

                        <h2 id="modalCodigoLabel" class="fw-bold display-6 mb-3">Código para registro</h2>

                        <!-- Fecha límite en estilo píldora -->
                        <div class="mx-auto mb-3" style="max-width: 380px;">
                            <div class="input-group pill">
                                <span class="input-group-text fw-bold">Seleccione una fecha límite</span>
                                <input type="date" id="fechaLimite" class="form-control">
                                <span class="input-group-text"><span class="bi bi-calendar3"></span></span>
                            </div>
                        </div>

                        <!-- Botón Generar -->
                        <button id="btnGenerar" class="btn btn-grad btn-green px-5 py-2 fs-5 mb-3">Generar</button>

                        <h3 class="fw-bold mb-2">Código:</h3>

                        <!-- Caja de código -->
                        <div class="mx-auto mb-4" style="max-width: 360px;">
                            <input id="txtCodigo" class="form-control form-control-lg code-box text-center fw-bold"
                                   type="text" placeholder="ABC124" readonly>
                            <small id="msgCopiado" class="text-success d-none">¡Copiado al portapapeles!</small>
                        </div>

                        <!-- Enviar por correo -->
                        <div class="row g-2 align-items-center justify-content-center">
                            <div class="col-auto">
                                <label for="emailDestino" class="col-form-label fs-5">Enviar a:</label>
                            </div>
                            <div class="col-12 col-md-7">
                                <input type="email" id="emailDestino" class="form-control pill-input"
                                       placeholder="correo@dirección.com">
                            </div>
                            <div class="col-12 col-md-auto">
                                <button id="btnEnviarCorreo" class="btn btn-grad btn-teal px-4">Enviar</button>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
        const tabla = document.getElementById('tablaComites').querySelector('tbody');
        let selectedRow = null;

        // Seleccionar fila con click
        tabla.addEventListener('click', (e) => {
          const tr = e.target.closest('tr');
          if(!tr) return;

          if(selectedRow) selectedRow.classList.remove('row-selected');
          selectedRow = tr;
          selectedRow.classList.add('row-selected');
        });

        // Incrementar / decrementar con flechas
        tabla.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-action]');
          if(!btn) return;

          const cell = btn.closest('td');
          const valueEl = cell.querySelector('.qty-value');
          let val = parseInt(valueEl.textContent || '0', 10);

          if(btn.dataset.action === 'inc') val++;
          if(btn.dataset.action === 'dec') val = Math.max(0, val - 1);

          valueEl.textContent = val;
        });

        // Agregar comité
        document.getElementById('btnAgregar').addEventListener('click', () => {
          const nombre = prompt('Nombre del comité nuevo:');
          if(!nombre) return;

          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="fw-semibold text-center"></td>
            <td>
              <div class="qty-cell">
                <span class="qty-value">0</span>
                <div class="d-flex flex-column">
                  <button class="btn-arrow up" data-action="inc"><i class="bi bi-caret-up-fill"></i></button>
                  <button class="btn-arrow down" data-action="dec"><i class="bi bi-caret-down-fill"></i></button>
                </div>
              </div>
            </td>`;
          tr.children[0].textContent = nombre.trim();
          tabla.appendChild(tr);

          if(selectedRow) selectedRow.classList.remove('row-selected');
          selectedRow = tr; selectedRow.classList.add('row-selected');
        });

        // Eliminar comité seleccionado
        document.getElementById('btnEliminar').addEventListener('click', () => {
          if(!selectedRow){
            alert('Selecciona una fila para eliminar.');
            return;
          }
          const nombre = selectedRow.children[0].textContent.trim();
          if(confirm(`¿Eliminar el comité "${nombre}"?`)){
            selectedRow.remove();
            selectedRow = null;
          }
        });
    </script>
</body>
</html>
