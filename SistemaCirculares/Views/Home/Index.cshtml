@{

    var ListaCirculares = ViewBag.Circulares;

}


<table id="tblCirculares" class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Título</th>
            <th>Circular</th>
            <th>Comité</th>
            <th>Evento</th>
        </tr>
    </thead>
    <tbody>


        @foreach (var Circular in ListaCirculares)
        {
            <tr>
                <th scope="row">@Circular.IdCircular</th>
                <td>@Circular.FechaCircular</td>
                <td>@Circular.NombreCircular</td>
                <td>
                    <button type="button" class="btn btn-sm btn-primary ver-circular" data-circular="3mdo">
                        Ver circular
                    </button>
                </td>
                <td>@Circular.NombreComite</td>
                <td>
                    <button type="button" class="btn btn-sm btn-primary ver-circular" data-circular="3social">
                        Ver evento
                    </button>
                </td>
            </tr>
        }




    </tbody>
</table>

<script>
    // Delegación de eventos (sirve para filas futuras también)
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.ver-circular');
      if (!btn) return;

      const id = btn.dataset.circular; // p.ej. "3mdo"
      console.log('Abrir circular:', id);

      // Ejemplos de acción:
      // window.location.href = `/circulares/${encodeURIComponent(id)}`;
      // abrirModalCircular(id);
    });
</script>
