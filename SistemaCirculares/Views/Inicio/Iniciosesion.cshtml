@{

	Layout = null;
}

<head>

	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
	<link href="~/css/iniciosesioncss/iniciosesion.css" rel="stylesheet" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap" rel="stylesheet">

</head>


<body>
	<div class="container merriweather-textfont contenedor">
		<div class="row align-items-center col-md-12">

			<div class="row">
				<h1 class="text-center">¡Bienvenido!</h1>
				<p class="text-center ptext">Sistema para Gestión de Circulares <br />Escuela Lomas de Cocorí</p>
			</div>

			<div class="InicioSesion col-md-8 offset-2">
				<h3 class="text-center mb-3">Iniciar sesión</h3>
				<form>
					<label class="form-label">Correo:</label>
					<div class="input-group mb-3">
						<span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-user"></i></span>
						<input id="InputEmail" type="text" class="form-control" placeholder="cedula@mep.go.cr" aria-label="Correo" aria-describedby="basic-addon1">
					</div>



					<div class="mb-3">
						<label class="form-label">Contraseña:</label>
						<div class="input-group mb-3">
							<span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-lock"></i></i></span>
							<input id="InputPassword" type="text" class="form-control" placeholder="Contraseña" aria-label="Contraseña" aria-describedby="basic-addon1">
						</div>
						<a href="#">¿Olvidaste tu contraseña?</a>
					</div>

					<div class="mb-3 form-check">
						<input type="checkbox" class="form-check-input" id="recordar">
						<label class="form-check-label" for="recordar">Recordarme</label>
					</div>

					<button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-right-to-bracket"></i> &nbsp; Ingresar</button>

					<div class="enlaces">
						<a href="#">Registrarse</a>
					</div>
				</form>

			</div>
		</div>
	</div>
</body>
