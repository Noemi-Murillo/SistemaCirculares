@{

    Layout = null;
}

<head>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
    <link href="~/css/iniciosesioncss/iniciosesion.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script defer src="~/js/userregistrationjs/userregistration.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap" rel="stylesheet">

</head>


<body>
    <div class="container merriweather-textfont contenedor">
        <div class="row align-items-center col-md-12">

            <div class="row">
                <h1 class="text-center">¡Bienvenido!</h1>
                <p class="text-center ptext">Sistema para Gestión de Circulares <br />Escuela Lomas de Cocorí</p>
            </div>

            <div class="InicioSesion col-md-8 offset-2">
                <h3 class="text-center mb-3">Iniciar sesión</h3>
                <form>
                    <label class="form-label">Correo:</label>
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-user"></i></span>
                        <input id="InputEmail" type="text" class="form-control" placeholder="cedula@mep.go.cr" aria-label="Correo" aria-describedby="basic-addon1">
                    </div>



                    <div class="mb-3">
                        <label class="form-label">Contraseña:</label>
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-lock"></i></i></span>
                            <input id="InputPassword" type="password" class="form-control" placeholder="Contraseña" aria-label="Contraseña" aria-describedby="basic-addon1">
                        </div>
                        <a href="#" data-bs-toggle="modal" data-bs-target="#modalRecuperar">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <button id="btnLogin" type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-right-to-bracket"></i> &nbsp; Ingresar</button>

                    <div class="enlaces text-center mt-3">
                        <a data-bs-toggle="modal" data-bs-target="#staticBackdrop"
                           class="btn btn-outline-primary mt-2 px-4 rounded-pill">
                            <i class="fa-solid fa-user-plus"></i> Crear cuenta
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</body>

<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- modal más grande -->
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-4" id="staticBackdropLabel">Registro al Sistema de Gestión de Circulares</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">

                <form>

                    <div class="row g-3">

                        <!-- Fila 1 -->
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control input-modern" id="txtNombreRegistro" placeholder="Nombre">
                                <label>Nombre</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="email" class="form-control input-modern" id="txtCorreoRegistro" placeholder="Correo">
                                <label>Correo electrónico</label>
                            </div>
                        </div>

                        <!-- Fila 2 -->
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control input-modern" id="txtApellido1Registro" placeholder="Primer apellido">
                                <label>Primer apellido</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating position-relative">
                                <input type="password" class="form-control input-modern" id="txtContrasenaRegistro" placeholder="Contraseña">
                                <label>Contraseña</label>
                            </div>
                        </div>

                        <!-- Fila 3 -->
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control input-modern" id="txtApellido2Registro" placeholder="Segundo apellido">
                                <label>Segundo apellido</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="password" class="form-control input-modern" id="txtConfirmarContrasena" placeholder="Confirmar contraseña">
                                <label>Confirmar contraseña</label>
                            </div>
                        </div>

                        <!-- Código -->
                        <div class="col-md-12 mt-2">
                            <div class="form-floating">
                                <input type="text" class="form-control input-modern" id="txtCodigoRegistro" placeholder="Código">
                                <label>Código de autorización</label>
                            </div>
                        </div>

                    </div>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" id="btnCrearUsuario" class="btn btn-primary">Registrarse</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRecuperar" tabindex="-1" aria-labelledby="modalRecuperarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="modalRecuperarLabel">
                    Recuperar contraseña
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <p>Ingresa tu correo electrónico y te enviaremos instrucciones para restablecer tu contraseña.</p>

                <div class="mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fa-solid fa-envelope"></i>
                        </span>
                        <input type="email" id="txtCorreoRecuperar" class="form-control" placeholder="correo@ejemplo.com">
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" id="btnEnviarRecuperacion" class="btn btn-primary">
                    <i class="fa-solid fa-paper-plane"></i> Enviar
                </button>
            </div>

        </div>
    </div>
</div>

